{
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "*": "allow"
  },
  "mcp": {
    "servers": {
      "brave": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "http://127.0.0.1:9222"
        ]
      },
      "brave-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl",
          "http://127.0.0.1:9222"
        ]
      }
    }
  }
}